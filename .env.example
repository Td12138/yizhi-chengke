# 复制为 .env 后按需填写。缺省全部走 mock，无密钥也能完整演示。
# mock=离线假数据（演示/开发） | qwen=通义 | glm=智谱 | deepseek=深度求索

VLM_PROVIDER=mock
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 质检回环上限（方案设计 §4.2）
VERIFY_MAX_RETRY=2

# 服务
APP_HOST=127.0.0.1
APP_PORT=8710
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
