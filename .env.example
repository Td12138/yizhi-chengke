# 复制为 .env 后按需填写。缺省全部走 mock，无密钥也能完整演示整条链路。
# .env 已被 .gitignore 忽略，密钥永不入库；代码里不含任何密钥。
#
# 切换真实模型只改两件事：改 PROVIDER，填 KEY。地址与模型名有内置缺省值，
# 需要自建代理或私有模型时才填 BASE_URL / MODEL（显式值优先于缺省）。

# ---- 视觉识别：图像 → 版面块 ----
# mock=内置样例 | qwen=通义(qwen-vl-max) | glm=智谱(glm-4v-plus)
# 注意：deepseek 没有视觉模型，VLM_PROVIDER=deepseek 会明确报错而不是猜
VLM_PROVIDER=mock
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

# ---- 语言模型：萃取 / 命题 / 讲解 ----
# mock=内置样例 | deepseek=deepseek-chat | qwen=qwen-plus | glm=glm-4-plus
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 命题 ↔ 质检回环的最大重试轮数
VERIFY_MAX_RETRY=2

# ---- v0.1.5 质检 / 判分 / 事件开关（关掉即回退旧行为）----
# 无 verify 的题做结构检查（题干/答案/题型），通过后标「结构检查」而非「已验算」
VERIFY_STRUCTURE_CHECK=1
# 填空判分追加 sympy 等价判定（反写方程 / 因式分解展开 / 分数小数互化）
JUDGE_SYMPY_EQUIV=1
# Agent 事件落库：run 回收 / 重启后前端重试可回放历史
EVENT_PERSIST=1
# 落库事件保留最近多少个 run
EVENT_PERSIST_RUNS=200

# ---- v0.1.5 混合检索（缺省 legacy，零依赖；hybrid 需嵌入端点）----
# legacy=2-gram 字段加权 | hybrid=2-gram + 向量 RRF 融合（端点故障自动回退 legacy）
RETRIEVAL_MODE=legacy
# OpenAI 兼容嵌入端点（如本地 llama-server：http://127.0.0.1:8848/v1）
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=

# 服务
APP_HOST=127.0.0.1
APP_PORT=8710
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# SERVE_WEB=1 时后端顺带托管 apps/web/dist（桌面版用；Web 开发模式留空或 0）
# 托管页面默认补 CSP 响应头；排障时可用 WEB_CSP=0 临时关闭，不影响桌面壳自带的 CSP
WEB_CSP=1
