# 复制为 .env 后按需填写。缺省全部走 mock，无密钥也能完整演示整条链路。
# .env 已被 .gitignore 忽略，密钥永不入库；代码里不含任何密钥。
#
# 切换真实模型只改两件事：改 PROVIDER，填 KEY。地址与模型名有内置缺省值，
# 需要自建代理或私有模型时才填 BASE_URL / MODEL（显式值优先于缺省）。

# ---- 视觉识别：图像 → 版面块 ----
# mock=内置样例 | qwen=通义(qwen-vl-max) | glm=智谱(glm-4v-plus)
# 注意：deepseek 没有视觉模型，VLM_PROVIDER=deepseek 会明确报错而不是猜
VLM_PROVIDER=mock
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

# ---- 语言模型：萃取 / 命题 / 讲解 ----
# mock=内置样例 | deepseek=deepseek-chat | qwen=qwen-plus | glm=glm-4-plus
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 质检回环上限（方案设计 §4.2）
VERIFY_MAX_RETRY=2

# 服务
APP_HOST=127.0.0.1
APP_PORT=8710
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
